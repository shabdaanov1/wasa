FROM golang:1.25-bookworm AS builder

WORKDIR /src/

RUN apt-get update && apt-get install -y gcc && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build -mod=readonly -o /app/webapi ./cmd/webapi


FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/webapi /app/webapi

WORKDIR /app

# Создаём папку для БД и задаём абсолютный путь через env
RUN mkdir -p /app/data
ENV CFG_DB_FILENAME=/app/data/database.db

EXPOSE 3000

CMD ["/app/webapi"]

